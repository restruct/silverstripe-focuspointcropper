{
	"name": "restruct/silverstripe-focuspointcropper",
	"description": "Even smarter automatic image cropping for SilverStripe",
	"type": "silverstripe-vendormodule",
	"keywords": ["silverstripe", "crop", "cropping", "focus", "focuspoint", "image"],
	"license": "BSD-3-Clause",
	"authors": [{
		"name": "Restruct",
		"homepage": "http://restruct.nl"
	}],
	"require": {
		"php": "^8.1",
		"silverstripe/framework": "^5 || ^6",
		"jonom/focuspoint": "^5 || ^6",
        "restruct/silverstripe-simpler": "~0.2 || ^1"
	},
	"require-dev": {
		"silverstripe/recipe-testing": "^3 || ^4"
	},
    "suggest": {
        "restruct/silverstripe-svg-images": "Crop support for SVG images; /dev/crop-compare uses its SVGImage class when installed"
    },
    "replace": {
        "micschk/silverstripe-focuspointcropper": "*"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\ImageCropper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\ImageCropper\\Tests\\": "tests/"
        }
    },
	"extra": {
        "expose": [
            "client"
        ]
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
