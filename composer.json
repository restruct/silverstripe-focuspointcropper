{
	"name": "restruct/silverstripe-focuspointcropper",
	"description": "Let editors crop images in the Silverstripe CMS: a crop region plus focus point per image, used by Cropped* image methods in templates. Builds on jonom/focuspoint.",
	"type": "silverstripe-vendormodule",
	"keywords": ["silverstripe", "silverstripe-module", "silverstripe-cms", "crop", "image-crop", "focus-point", "focuspoint", "image", "responsive-images", "asset-admin"],
	"license": "BSD-3-Clause",
	"authors": [
		{
			"name": "Restruct",
			"email": "dev@restruct.nl",
			"homepage": "https://restruct.nl"
		}
	],
	"require": {
		"php": "^8.1",
		"silverstripe/framework": "^5 || ^6",
		"jonom/focuspoint": "^5 || ^6",
        "restruct/silverstripe-simpler": "~0.2 || ^1"
	},
	"require-dev": {
		"silverstripe/recipe-testing": "^3 || ^4",
		"restruct/silverstripe-svg-images": "^3.1"
	},
    "suggest": {
        "restruct/silverstripe-svg-images": "Crop support for SVG images; /dev/crop-compare uses its SVGImage class when installed"
    },
    "replace": {
        "micschk/silverstripe-focuspointcropper": "*"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\ImageCropper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\ImageCropper\\Tests\\": "tests/"
        }
    },
	"extra": {
        "expose": [
            "client"
        ]
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
