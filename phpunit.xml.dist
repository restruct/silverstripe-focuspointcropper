<?xml version="1.0" encoding="UTF-8"?>
<!-- For running the suite from a host project that installs this module; see README "Running the
     tests". failOnWarning is pinned because warning escalation is the RUNNER's default and differs
     by PHPUnit major (9 on Silverstripe 5 converts warnings, 11 on Silverstripe 6 does not). -->
<phpunit bootstrap="vendor/silverstripe/framework/tests/bootstrap.php" colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="focuspointcropper">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
